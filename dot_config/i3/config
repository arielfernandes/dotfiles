# i3 config file (v4) — Main entry point
# Modular structure: each include handles one concern

# ============================================================
# Core variables (must be first — used by includes)
# ============================================================
set $mod Mod4
set $terminal alacritty
set $editor emacsclient -c -a ""
set $browser firefox
set $filemanager pcmanfm
set $launcher rofi -combi-modi drun -theme gruvbox-dark-soft -font "hack 12" -show combi -icon-theme "Tela-circle-blue" -show-icons

# Font for window titles (bar overrides in bar.conf)
font pango:Hack Nerd Font 10

# Direction variables (vim keys)
set $up k
set $down j
set $left h
set $right l
set $vertical v
set $horizontal semicolon

# ============================================================
# Includes (order matters: variables → theme → autostart → keys → windows → workspaces → bar)
# ============================================================
include ~/.config/i3/themes/doom-tomorrow-night.conf
include ~/.config/i3/autostart.conf
include ~/.config/i3/keybindings.conf
include ~/.config/i3/window.conf
include ~/.config/i3/workspace.conf
include ~/.config/i3/gaps.conf
include ~/.config/i3/bar.conf

# ============================================================
# Global behavior
# ============================================================
# Smart borders: hide when only one window
hide_edge_borders smart

# Drag floating windows with $mod + mouse
floating_modifier $mod
tiling_drag modifier titlebar

# Focus follows mouse (no = click to focus)
focus_follows_mouse no

# ============================================================
# System mode (lock, logout, suspend, etc.) — $mod+x
# ============================================================
bindsym $mod+x mode "$mode_system"
set $mode_system (l)ock, (e)xit, switch_(u)ser, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id i3exit lock, mode "default"
    bindsym s exec --no-startup-id i3exit suspend, mode "default"
    bindsym u exec --no-startup-id i3exit switch_user, mode "default"
    bindsym e exec --no-startup-id i3exit logout, mode "default"
    bindsym h exec --no-startup-id i3exit hibernate, mode "default"
    bindsym r exec --no-startup-id i3exit reboot, mode "default"
    bindsym Shift+s exec --no-startup-id i3exit shutdown, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ============================================================
# Resize mode (with exit bindings)
# ============================================================
mode "resize" {
    bindsym $left       resize shrink width 10 px or 10 ppt
    bindsym $down       resize grow height 10 px or 10 ppt
    bindsym $up         resize shrink height 10 px or 10 ppt
    bindsym $right      resize grow width 10 px or 10 ppt

    bindsym Left        resize shrink width 10 px or 10 ppt
    bindsym Down        resize grow height 10 px or 10 ppt
    bindsym Up          resize shrink height 10 px or 10 ppt
    bindsym Right       resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}